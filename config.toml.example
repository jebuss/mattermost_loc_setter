# Configuration for Mattermost Location Setter
# Copy this file to ~/.config/mm-status/config.toml and fill in your details.

# --- Credentials (REQUIRED) ---
# Get these from your Mattermost account settings
access_token = "your_mattermost_access_token"
user_id = "your_mattermost_user_id"

# --- Server (Optional) ---
# URL of your Mattermost server
url = "https://your-mattermost-server.com"

# --- Working Hours (Optional) ---
# Define when the script should check and update your status
# Weekdays: 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday, 5=Saturday, 6=Sunday
[working_hours]
weekdays = [0, 1, 2, 3, 4]  # Monday to Friday (default working days)
start_time = "08:00"         # Default start time (format: "HH:MM")
end_time = "18:00"           # Default end time (format: "HH:MM")

# Optional: Define different working hours for specific days
# If a day is not specified, the default start_time and end_time are used
[working_hours.daily]
monday = { start_time = "08:00", end_time = "18:00" }
tuesday = { start_time = "08:00", end_time = "18:00" }
wednesday = { start_time = "09:00", end_time = "18:00" }
thursday = { start_time = "08:00", end_time = "17:00" }
friday = { start_time = "08:00", end_time = "16:00" }
# saturday and sunday are not specified - they won't be working days unless added to 'weekdays'

# --- Networks (Optional) ---
# Define a list of networks to check against.
# The script will use the first match it finds.

[[networks]]
name = "At the Office"
emoji = "office"
ip_prefix = "10.1.0."

[[networks]]
name = "On Campus"
emoji = "books"
ip_prefix = "172.16.0."

[[networks]]
name = "Home Office"
emoji = "house"
ip_prefix = "192.168.1."

# --- Absence Periods (Optional) ---
# Define periods when you're away (vacation, sick leave, etc.)
# These take priority over location-based status updates
# Times can be in ISO 8601 format: "YYYY-MM-DDTHH:MM:SS" or "YYYY-MM-DD"
# If time is omitted, assumes start of day (00:00:00) for start_time and end of day (23:59:59) for end_time

[[absence_periods]]
name = "Summer Vacation"
start_time = "2026-07-01"
end_time = "2026-07-15"
status = "On Vacation"
emoji = "palm_tree"

[[absence_periods]]
name = "Sick Leave"
start_time = "2026-03-10T08:00:00"
end_time = "2026-03-12T18:00:00"
status = "Out Sick"
emoji = "face_with_thermometer"